# dr_onsite_adap 설정 (UI 팀 x86 개발기) — 필요한 값만 채우세요.
# run.sh 가 실행 전에 이 파일을 읽어 환경변수로 넣습니다.

# 검출 가중치 경로 (담당자에게 받은 파일). 상대경로는 레포 루트 기준.
DEPAL_WEIGHTS=./weights/continual_master_v11.pth
DEPAL_NUM_CLASSES=5

# 윗면 기하 알고리즘 (v2 권장)
DEPAL_GEOM_ALGO=v2

# 연산 장치. GPU 있으면 cuda, 없으면 cpu.
DEPAL_DEVICE=cuda

# 신뢰도 임계
DEPAL_CONF_THRES=0.5

# ── 실제 카메라를 붙일 때만 (x86 개발기엔 보통 없음) ──
# 카메라가 없으면 아래는 비워두고, 코드에서 ReplaySource 로 프레임을 재생하세요.
# DEPAL_CAMERA_BACKEND=orbbec
# DEPAL_CAMERA_SERIAL=
